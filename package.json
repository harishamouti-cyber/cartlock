{
  "name": "cartlock-exit-intent-price-lock",
  "private": true,
  "version": "1.0.0",
  "description": "CartLock: Exit-Intent Price Lock — Built-for-Shopify application with Cryptographic Cart Reservation, Margin Shield Discount Function, and Theme App Embed",
